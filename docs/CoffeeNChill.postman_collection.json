        {
          "name": "Get All Menu Items (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Payload contains a count and an items array', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('count');",
                  "    pm.expect(body.items).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('At least three seeded items are present', function () {",
                  "    pm.expect(pm.response.json().count).to.be.at.least(3);",
                  "});",
                  "",
                  "pm.test('Every item exposes the full DTO shape', function () {",
                  "    pm.response.json().items.forEach(function (item) {",
                  "        pm.expect(item).to.have.all.keys(",
                  "            'category', 'sku', 'name', 'description', 'price', 'isAvailable', 'lastModified');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
