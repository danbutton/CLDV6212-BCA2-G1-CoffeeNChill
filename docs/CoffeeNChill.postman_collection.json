                  "pm.test('Every returned item belongs to the requested partition', function () {",
                  "    const expected = pm.collectionVariables.get('testCategory');",
                  "    pm.response.json().items.forEach(function (item) {",
                  "        pm.expect(item.category).to.eql(expected);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Category filter narrows the result set', function () {",
                  "    pm.expect(pm.response.json().count).to.be.at.least(1);",
                  "});"
                ]
              }
            }
