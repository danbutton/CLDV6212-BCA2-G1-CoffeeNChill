    {
      "name": "Documents - Azure Blob Storage",
      "description": "Upload, list and download operations against the staff-docs blob container.",
      "item": [
        {
          "name": "Upload Staff Document (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response reports the stored file name and size', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('fileName');",
                  "    pm.expect(body.sizeBytes).to.be.a('number').and.to.be.above(0);",
                  "});",
                  "",
                  "// Chain the filename into the download request below.",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('uploadedFileName', pm.response.json().fileName);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a local .pdf, .docx, .txt, .png or .jpg before running (e.g. barista-recipes.pdf)."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            },
            "description": "Streams a multipart/form-data upload into the staff-docs blob container..\n\nYou must attach a file manually - Postman does not persist binary paths across exports."
          }
        },
        {
          "name": "Upload - no file supplied (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error explains the missing form field', function () {",
                  "    pm.expect(pm.response.json().error).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            },
            "description": "Negative test: a non-multipart request must be rejected with 400."
          }
        },
        {
          "name": "List Staff Documents (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Payload contains a count and a documents array', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('count');",
                  "    pm.expect(body.documents).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each document reports name, size and last modified', function () {",
                  "    pm.response.json().documents.forEach(function (doc) {",
                  "        pm.expect(doc).to.have.property('fileName');",
                  "        pm.expect(doc).to.have.property('sizeBytes');",
                  "        pm.expect(doc).to.have.property('lastModified');",
                  "        pm.expect(doc).to.have.property('contentType');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "description": "Lists every blob in the staff-docs container with metadata."
          }
        },
        {
          "name": "Download Staff Document (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response carries a body', function () {",
                  "    pm.expect(pm.response.responseSize).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Content-Disposition prompts a download', function () {",
                  "    const cd = pm.response.headers.get('Content-Disposition');",
                  "    pm.expect(cd).to.include('attachment');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/download/{{uploadedFileName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "download",
                "{{uploadedFileName}}"
              ]
            },
            "description": "Streams the previously uploaded file back. Uses the filename captured by the Upload request."
          }
        },
        {
          "name": "Download - missing file (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Error names the missing document', function () {",
                  "    pm.expect(pm.response.json().error).to.include('does-not-exist.pdf');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/download/does-not-exist.pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "download",
                "does-not-exist.pdf"
              ]
            },
            "description": "Negative test: requesting an absent file must return 404 with a JSON error."
          }
        }
      ]
    }
  ]
}