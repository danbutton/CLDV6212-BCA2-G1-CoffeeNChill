      "name": "Menu - Table Storage",
      "item": [
        {
          "name": "Create Menu Item (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Entity is echoed back', function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.PartitionKey).to.eql('Hot Drinks');",
                  "    pm.expect(b.RowKey).to.eql('COF-001');",
                  "    pm.expect(b.Name).to.eql('Espresso');",
                  "});",
                  "pm.test('Price is numeric', function () { pm.expect(pm.response.json().Price).to.be.a('number'); });"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "packages": {},
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"PartitionKey\": \"Hot Drinks\",\n  \"RowKey\": \"COF-001\",\n  \"Name\": \"Espresso\",\n  \"Description\": \"Double shot, locally roasted\",\n  \"Price\": 28.5,\n  \"IsAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            },
            "description": "Creates a menu entity. PartitionKey = category, RowKey = SKU."
          },
          "response": []
        },
