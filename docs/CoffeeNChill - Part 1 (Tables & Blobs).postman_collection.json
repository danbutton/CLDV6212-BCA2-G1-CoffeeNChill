        {
          "name": "Get All Menu Items (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
                  "pm.test('At least two items present', function () { pm.expect(pm.response.json().length).to.be.at.least(2); });",
                  "pm.test('Each item exposes the storage keys', function () {",
                  "    pm.response.json().forEach(function (i) {",
                  "        pm.expect(i).to.have.property('PartitionKey');",
                  "        pm.expect(i).to.have.property('RowKey');",
                  "        pm.expect(i).to.have.property('Name');",
                  "        pm.expect(i).to.have.property('Price');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
